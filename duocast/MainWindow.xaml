<Window x:Class="DuoCast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DuoCast · 双路音频分发器"
        Width="1120" Height="720" MinWidth="980" MinHeight="660"
        Background="#0F0E0E" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#161513" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#1FFFFFFF" />

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C9C3BA" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E2DDD5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2724" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5A554F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0F0E0E" />
            <Setter Property="Background" Value="#F2F2F2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" VerticalAlignment="Center" Background="#302D28" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#F2F2F2" Height="4" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#F2F2F2" CornerRadius="7" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoldSlider" TargetType="Slider" BasedOn="{StaticResource DarkSlider}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" VerticalAlignment="Center" Background="#302D28" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#E8C268" Height="4" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#E8C268" CornerRadius="7" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#131210">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="20" Height="20">
                        <Rectangle Stroke="#E8C268" StrokeThickness="1" Opacity="0.5" />
                        <Path Data="M4,10 L8,10" Stroke="#F2F2F2" StrokeThickness="1.4" />
                        <Path Data="M8,10 C11,10 11,5 14,5" Stroke="#F2F2F2" StrokeThickness="1.4" />
                        <Path Data="M8,10 C11,10 11,15 14,15" Stroke="#E8C268" StrokeThickness="1.4" />
                    </Grid>
                    <TextBlock Text="DuoCast" Foreground="#F2F2F2" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Border Width="1" Height="14" Background="#2E2B27" Margin="11,0" />
                    <TextBlock Text="双路音频分发器 · WASAPI 双输出" Foreground="#8A857F" FontSize="11.5"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnEq" Content="均衡器" Style="{StaticResource GhostButton}"
                            Height="26" Padding="12,0" Margin="0,0,8,0" Click="BtnEq_Click" />
                    <Button x:Name="BtnSettings" Content="高级设置" Style="{StaticResource GhostButton}"
                            Height="26" Padding="12,0" Margin="0,0,10,0" Click="BtnSettings_Click" />
                    <Border BorderBrush="#24FFFFFF" BorderThickness="1" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="EngineDot" Width="6" Height="6" Fill="#6E6862" VerticalAlignment="Center" />
                            <TextBlock x:Name="EngineText" Text="引擎待机" Foreground="#C9C3BA" FontSize="11"
                                       Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 输入源 -->
        <Border Grid.Row="1" Margin="24,16,24,0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Width="228" VerticalAlignment="Center">
                    <TextBlock Text="输入源" Foreground="#7A746C" FontSize="10.5" />
                    <TextBlock x:Name="SourceText" Text="未启动" Foreground="#F2F2F2" FontSize="13"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="Seg0" Tag="0" Content="系统音频" Style="{StaticResource GhostButton}"
                            Height="30" Padding="12,0" Click="Seg_Click" />
                    <Button x:Name="Seg1" Tag="1" Content="采集设备" Style="{StaticResource GhostButton}"
                            Height="30" Padding="12,0" Margin="-1,0,0,0" Click="Seg_Click" />
                    <Button x:Name="Seg2" Tag="2" Content="本地文件" Style="{StaticResource GhostButton}"
                            Height="30" Padding="12,0" Margin="-1,0,0,0" Click="Seg_Click" />
                    <Button x:Name="BtnCaptureDev" Content="选择采集设备" Style="{StaticResource GhostButton}"
                            Height="30" Padding="12,0" Margin="10,0,0,0" Visibility="Collapsed"
                            Click="BtnCaptureDev_Click" />
                    <Button x:Name="BtnPickFile" Content="选择文件" Style="{StaticResource GhostButton}"
                            Height="30" Padding="12,0" Margin="10,0,0,0" Visibility="Collapsed"
                            Click="BtnPickFile_Click" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FormatText" Text="—" FontFamily="Consolas" Foreground="#A8A29A"
                               FontSize="11.5" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button x:Name="BtnStart" Content="开始分发" Style="{StaticResource PrimaryButton}"
                            Height="32" Padding="18,0" Click="BtnStart_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 两路输出 -->
        <Grid Grid.Row="2" Margin="24,16,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 通道 A -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="34">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" Background="#26241F" BorderBrush="#2BFFFFFF" BorderThickness="1">
                                <TextBlock Text="A" Foreground="#F2F2F2" FontWeight="SemiBold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="输出 A · 主控" Foreground="#F2F2F2" FontSize="13.5" />
                                <TextBlock x:Name="StatusA" Text="未连接" Foreground="#8A857F" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="BtnMuteA" Content="静音" Style="{StaticResource GhostButton}" Height="26"
                                Padding="10,0" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="BtnMuteA_Click" />
                    </Grid>

                    <Button x:Name="BtnDevA" Grid.Row="1" Height="44" Margin="0,16,0,0"
                            Style="{StaticResource GhostButton}" Padding="12,0"
                            HorizontalContentAlignment="Stretch" Click="BtnDevA_Click">
                        <Grid>
                            <TextBlock x:Name="DevAName" Text="选择输出设备" Foreground="#F2F2F2" FontSize="12.5"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                            <Path Data="M0,0 L4,4 L8,0" Stroke="#8A857F" StrokeThickness="1.2"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <Grid>
                            <TextBlock Text="通道增益" Foreground="#7A746C" FontSize="10.5" />
                            <TextBlock x:Name="DbA" Text="—" Foreground="#8A857F" FontSize="11" FontFamily="Consolas"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="VolTextA" Text="78" Foreground="#F2F2F2" FontSize="40" FontWeight="SemiBold" />
                            <TextBlock Text="%" Foreground="#8A857F" FontSize="17" VerticalAlignment="Bottom"
                                       Margin="3,0,0,8" />
                        </StackPanel>
                        <Slider x:Name="SliderA" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="120"
                                Value="78" Margin="0,8,0,0" ValueChanged="SliderA_ValueChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,14,0,0">
                        <Grid>
                            <TextBlock Text="输出电平" Foreground="#7A746C" FontSize="10.5" />
                            <TextBlock x:Name="PeakA" Text="—" Foreground="#8A857F" FontSize="10.5"
                                       FontFamily="Consolas" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Height="6" Background="#211F1B" Margin="0,8,0,0">
                            <Rectangle x:Name="MeterA" Fill="#F2F2F2" HorizontalAlignment="Left" Width="0" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="延迟偏移" Foreground="#7A746C" FontSize="10.5" VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Button x:Name="OffAMinus" Content="−" Style="{StaticResource GhostButton}" Width="26"
                                    Height="28" Padding="0" Click="OffAMinus_Click" />
                            <TextBlock x:Name="OffAValue" Text="0 ms" Foreground="#E2DDD5" FontSize="11.5"
                                       FontFamily="Consolas" Width="64" TextAlignment="Center" VerticalAlignment="Center" />
                            <Button x:Name="OffAPlus" Content="+" Style="{StaticResource GhostButton}" Width="26"
                                    Height="28" Padding="0" Click="OffAPlus_Click" />
                        </StackPanel>
                        <TextBlock x:Name="UnderA" Text="欠载 0" Foreground="#6E6862" FontSize="10.5"
                                   FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 通道 B -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="34">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" Background="#241F16" BorderBrush="#2BFFFFFF" BorderThickness="1">
                                <TextBlock Text="B" Foreground="#E8C268" FontWeight="SemiBold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="输出 B · 辅助" Foreground="#F2F2F2" FontSize="13.5" />
                                <TextBlock x:Name="StatusB" Text="未连接" Foreground="#8A857F" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="BtnMuteB" Content="静音" Style="{StaticResource GhostButton}" Height="26"
                                Padding="10,0" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="BtnMuteB_Click" />
                    </Grid>

                    <Button x:Name="BtnDevB" Grid.Row="1" Height="44" Margin="0,16,0,0"
                            Style="{StaticResource GhostButton}" Padding="12,0"
                            HorizontalContentAlignment="Stretch" Click="BtnDevB_Click">
                        <Grid>
                            <TextBlock x:Name="DevBName" Text="选择输出设备" Foreground="#F2F2F2" FontSize="12.5"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                            <Path Data="M0,0 L4,4 L8,0" Stroke="#8A857F" StrokeThickness="1.2"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <Grid>
                            <TextBlock Text="通道增益" Foreground="#7A746C" FontSize="10.5" />
                            <TextBlock x:Name="DbB" Text="—" Foreground="#8A857F" FontSize="11" FontFamily="Consolas"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="VolTextB" Text="52" Foreground="#F2F2F2" FontSize="40" FontWeight="SemiBold" />
                            <TextBlock Text="%" Foreground="#8A857F" FontSize="17" VerticalAlignment="Bottom"
                                       Margin="3,0,0,8" />
                        </StackPanel>
                        <Slider x:Name="SliderB" Style="{StaticResource GoldSlider}" Minimum="0" Maximum="120"
                                Value="52" Margin="0,8,0,0" ValueChanged="SliderB_ValueChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,14,0,0">
                        <Grid>
                            <TextBlock Text="输出电平" Foreground="#7A746C" FontSize="10.5" />
                            <TextBlock x:Name="PeakB" Text="—" Foreground="#8A857F" FontSize="10.5"
                                       FontFamily="Consolas" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Height="6" Background="#211F1B" Margin="0,8,0,0">
                            <Rectangle x:Name="MeterB" Fill="#E8C268" HorizontalAlignment="Left" Width="0" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="延迟偏移" Foreground="#7A746C" FontSize="10.5" VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Button x:Name="OffBMinus" Content="−" Style="{StaticResource GhostButton}" Width="26"
                                    Height="28" Padding="0" Click="OffBMinus_Click" />
                            <TextBlock x:Name="OffBValue" Text="0 ms" Foreground="#E2DDD5" FontSize="11.5"
                                       FontFamily="Consolas" Width="64" TextAlignment="Center" VerticalAlignment="Center" />
                            <Button x:Name="OffBPlus" Content="+" Style="{StaticResource GhostButton}" Width="26"
                                    Height="28" Padding="0" Click="OffBPlus_Click" />
                        </StackPanel>
                        <TextBlock x:Name="UnderB" Text="欠载 0" Foreground="#6E6862" FontSize="10.5"
                                   FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="#131210">
            <Grid Margin="20,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" Text="就绪" Foreground="#8A857F" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />

                <TextBlock x:Name="DriftText" Grid.Column="1" Text="漂移 —" Foreground="#6E6862" FontSize="10.5"
                           FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,18,0" />

                <TextBlock x:Name="ClockText" Grid.Column="2" Text="00:00" Foreground="#6E6862" FontSize="10.5"
                           FontFamily="Consolas" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
