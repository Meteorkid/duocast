<Window x:Class="DuoCast.EqualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DuoCast · 均衡器"
        Width="640" Height="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#161513" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#1FFFFFFF" />

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C9C3BA" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0F0E0E" />
            <Setter Property="Background" Value="#F2F2F2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 竖向 EQ 滑块：细轨道 + 零位刻度 + 颜色由 Foreground 决定（A 白 / B 金） -->
        <Style x:Key="EqSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="140" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="TickFrequency" Value="0.5" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Width="2" HorizontalAlignment="Center" Background="#2E2A24" />
                            <Border Width="16" Height="1" VerticalAlignment="Center" Background="#3A342C" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Border Height="4" VerticalAlignment="Center"
                                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0F0E0E" BorderBrush="#2BFFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#131210" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="均衡器" Foreground="#F2F2F2" FontSize="13.5" FontWeight="SemiBold" />
                        <Border Width="1" Height="14" Background="#2E2B27" Margin="12,0" />
                        <TextBlock Text="10 段图示 · 31 Hz – 16 kHz · Q 1.41" Foreground="#8A857F" FontSize="11"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnBypass" Content="旁通：关" Style="{StaticResource GhostButton}"
                                Height="26" Padding="11,0" Margin="0,0,8,0" Click="BtnBypass_Click" />
                        <Button x:Name="BtnClose" Content="×" Style="{StaticResource GhostButton}" Width="30"
                                Height="28" Padding="0" FontSize="15" Click="BtnClose_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,20,12">

                <!-- 预设 -->
                <Grid>
                    <TextBlock Text="预设（同时写入 A / B）" Foreground="#7A746C" FontSize="10.5"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="平直" Style="{StaticResource GhostButton}" Height="26" Padding="12,0"
                                Click="PresetFlat_Click" />
                        <Button Content="低频" Style="{StaticResource GhostButton}" Height="26" Padding="12,0"
                                Margin="8,0,0,0" Click="PresetBass_Click" />
                        <Button Content="人声" Style="{StaticResource GhostButton}" Height="26" Padding="12,0"
                                Margin="8,0,0,0" Click="PresetVocal_Click" />
                        <Button Content="高频" Style="{StaticResource GhostButton}" Height="26" Padding="12,0"
                                Margin="8,0,0,0" Click="PresetBright_Click" />
                        <Button x:Name="BtnReset" Content="复位" Style="{StaticResource GhostButton}" Height="26"
                                Padding="12,0" Margin="8,0,0,0" Click="BtnReset_Click" />
                    </StackPanel>
                </Grid>

                <!-- 通道 A / B -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="12,12">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" Background="#26241F" BorderBrush="#2BFFFFFF"
                                            BorderThickness="1">
                                        <TextBlock Text="A" Foreground="#F2F2F2" FontWeight="SemiBold" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="主控通道" Foreground="#C9C3BA" FontSize="11" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="±12 dB" Foreground="#5F5A54" FontSize="10" FontFamily="Consolas"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel x:Name="EqA" Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="12,12">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" Background="#241F16" BorderBrush="#2BFFFFFF"
                                            BorderThickness="1">
                                        <TextBlock Text="B" Foreground="#E8C268" FontWeight="SemiBold" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="辅助通道" Foreground="#C9C3BA" FontSize="11" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="±12 dB" Foreground="#5F5A54" FontSize="10" FontFamily="Consolas"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel x:Name="EqB" Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Margin="0,14,0,0" Foreground="#6E6862" FontSize="10.5" TextWrapping="Wrap"
                           LineHeight="17"
                           Text="每段是一个 RBJ peaking 双二阶滤波器，级联顺序为 31 Hz → 16 kHz。均衡在软件增益之前处理，所以调整音量不会改变频响曲线；增益为 0 的段直接短路，不产生额外运算。滑块吸附到 0.5 dB。" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部 -->
            <Border Grid.Row="2" Background="#131210" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <TextBlock Text="改动实时生效，参数按通道保留，重新开始分发不会丢" Foreground="#6E6862"
                               FontSize="10.5" VerticalAlignment="Center" />
                    <Button Content="完成" Style="{StaticResource PrimaryButton}" Height="30" Padding="24,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnClose_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
